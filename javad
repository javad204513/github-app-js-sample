            QMessageBox.warning(self, "خطا", "لطفاً وسیله نقلیه‌ای را برای حذف انتخاب کنید.")
            return

        reply = QMessageBox.question(self, "حذف وسیله نقلیه", "آیا مطمئن هستید که می‌خواهید این وسیله نقلیه را حذف کنید؟",
