    def load_shift_types(self):
        """Loads all defined shift types into the table and combo box."""
        shift_types = self.shift_controller.get_all_shift_types()
        self.shift_types_table.setRowCount(len(shift_types))
        self.shift_type_combo.clear()
        for row, shift_type in enumerate(shift_types):
            self.shift_types_table.setItem(row, 0, QTableWidgetItem(str(shift_type.id)))
            self.shift_types_table.setItem(row, 1, QTableWidgetItem(shift_type.name))
            self.shift_types_table.setItem(row, 2, QTableWidgetItem(f"{shift_type.start_time} - {shift_type.end_time}"))
            self.shift_type_combo.addItem(shift_type.name, shift_type.id)

    def add_shift_type(self):
        """Adds a new shift type based on form input."""
        name = self.shift_name_input.text()
        start_time = self.shift_start_time_input.text()
        end_time = self.shift_end_time_input.text()

        if not (name and start_time and end_time):
            QMessageBox.warning(self, "خطا", "لطفاً تمام فیلدهای نوع شیفت را پر کنید.")
            return

        success, message = self.shift_controller.add_shift_type(name, start_time, end_time)
        QMessageBox.information(self, "افزودن نوع شیفت", message)
        if success:
            self.load_shift_types()
            self.shift_name_input.clear()
            self.shift_start_time_input.setText("08:00")
            self.shift_end_time_input.setText("16:00")

    def load_drivers_for_combo(self):
        """Loads all drivers into the driver combo box."""
        drivers = self.driver_controller.get_all_drivers()
        self.driver_combo.clear()
        for driver in drivers:
            self.driver_combo.addItem(f"{driver.first_name} {driver.last_name}", driver.id)

    def assign_shift(self):
        """Assigns a selected shift type to a driver on a specific date."""
        selected_driver_id = self.driver_combo.currentData()
        selected_shift_id = self.shift_type_combo.currentData()
        shift_date = self.shift_date_input.date().toPyDate() # Get Gregorian date

        if not selected_driver_id or not selected_shift_id:
            QMessageBox.warning(self, "خطا", "لطفاً راننده و نوع شیفت را انتخاب کنید.")
            return

        success, message = self.shift_controller.assign_shift_to_driver(selected_driver_id, selected_shift_id, shift_date)
        QMessageBox.information(self, "تخصیص شیفت", message)
        if success:
            self.load_assigned_shifts()

    def load_assigned_shifts(self):
        """Loads all assigned shifts into the table."""
        assigned_shifts = self.shift_controller.get_driver_shifts()
        self.assigned_shifts_table.setRowCount(len(assigned_shifts))
        for row, assignment in enumerate(assigned_shifts):
            self.assigned_shifts_table.setItem(row, 0, QTableWidgetItem(str(assignment.id)))
            self.assigned_shifts_table.setItem(row, 1, QTableWidgetItem(f"{assignment.driver.first_name} {assignment.driver.last_name}"))
            self.assigned_shifts_table.setItem(row, 2, QTableWidgetItem(assignment.shift.name))
            # Convert Gregorian date from DB to Shamsi string for display
            self.assigned_shifts_table.setItem(row, 3, QTableWidgetItem(self.converter.gregorian_to_shamsi(assignment.shift_date)))
            self.assigned_shifts_table.setItem(row, 4, QTableWidgetItem(f"{assignment.shift.start_time} - {assignment.shift.end_time}"))

