    def _create_kpi_card(self, title, value, color):
        """Creates a KPI card widget."""
        frame = QFrame()
        frame.setStyleSheet(f"""
            QFrame {{
                background-color: {color};
                color: white;
                border-radius: 12px;
                padding: 15px;
                margin: 5px;
                box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.2);
            }}
            QLabel {{
                color: white;
            }}
        """)
        layout = QVBoxLayout(frame)
        title_label = QLabel(title)
        title_label.setStyleSheet("font-size: 16px; font-weight: bold;")
        value_label = QLabel(value)
        value_label.setStyleSheet("font-size: 28px; font-weight: bold;")
        layout.addWidget(title_label, alignment=Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(value_label, alignment=Qt.AlignmentFlag.AlignCenter)
        return frame, value_label

    def _create_chart_frame(self, title):
        """Creates a frame for a chart with a title."""
        frame = QFrame()
        layout = QVBoxLayout(frame)
        chart_title = QLabel(f"<h3>{title}</h3>")
        chart_title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(chart_title)
        return frame

    def refresh_dashboard(self):
        """Refreshes all data and charts on the dashboard."""
        # Update KPIs
        drivers = self.driver_controller.get_all_drivers()
        active_drivers = len([d for d in drivers if d.is_active])
        self.drivers_kpi[1].setText(str(active_drivers))

        vehicles = self.vehicle_controller.get_all_vehicles()
        available_vehicles = len([v for v in vehicles if v.status == 'Available'])
        self.vehicles_available_kpi[1].setText(str(available_vehicles))

        missions = self.mission_controller.get_all_missions()
        in_progress_missions = len([m for m in missions if m.status == 'In Progress'])
        pending_missions = len([m for m in missions if m.status == 'Pending'])
        completed_missions = len([m for m in missions if m.status == 'Completed'])

        self.missions_in_progress_kpi[1].setText(str(in_progress_missions))
        self.missions_pending_kpi[1].setText(str(pending_missions))
        self.missions_completed_kpi[1].setText(str(completed_missions))

        # Update Charts
        self._update_vehicle_status_chart(vehicles)
        self._update_mission_status_chart(missions)

        # Update Alerts
        self._check_alerts(drivers, vehicles)

    def _update_vehicle_status_chart(self, vehicles):
        """Updates the pie chart for vehicle status."""
        status_counts = {}
        for vehicle in vehicles:
            status_counts[vehicle.status] = status_counts.get(vehicle.status, 0) + 1

        labels = list(status_counts.keys())
        sizes = list(status_counts.values())

        self.vehicle_status_ax.clear()
        if not sizes:
            self.vehicle_status_ax.text(0.5, 0.5, 'داده‌ای نیست', horizontalalignment='center', verticalalignment='center', transform=self.vehicle_status_ax.transAxes, fontproperties={'family':'Arial Unicode MS'})
        else:
            self.vehicle_status_ax.pie(sizes, labels=labels, autopct='%1.1f%%', startangle=90, colors=plt.cm.Paired.colors, textprops={'fontproperties': 'Arial Unicode MS'})
        self.vehicle_status_ax.axis('equal') # Equal aspect ratio ensures that pie is drawn as a circle.
        self.vehicle_status_figure.tight_layout()
        self.vehicle_status_canvas.draw()

    def _update_mission_status_chart(self, missions):
        """Updates the pie chart for mission status."""
        status_counts = {}
        for mission in missions:
            status_counts[mission.status] = status_counts.get(mission.status, 0) + 1

        labels = list(status_counts.keys())
        sizes = list(status_counts.values())

        self.mission_status_ax.clear()
        if not sizes:
            self.mission_status_ax.text(0.5, 0.5, 'داده‌ای نیست', horizontalalignment='center', verticalalignment='center', transform=self.mission_status_ax.transAxes, fontproperties={'family':'Arial Unicode MS'})
        else:
            self.mission_status_ax.pie(sizes, labels=labels, autopct='%1.1f%%', startangle=90, colors=plt.cm.Set3.colors, textprops={'fontproperties': 'Arial Unicode MS'})
        self.mission_status_ax.axis('equal') # Equal aspect ratio ensures that pie is drawn as a circle.
        self.mission_status_figure.tight_layout()
        self.mission_status_canvas.draw()

    def _check_alerts(self, drivers, vehicles):
        """Checks for upcoming expiry dates and displays alerts."""
        alerts = []
        today = date.today()

        for driver in drivers:
            if driver.license_expiry_date and driver.license_expiry_date < today + timedelta(days=60) and driver.license_expiry_date >= today:
                alerts.append(f"تاریخ انقضای گواهینامه راننده {driver.first_name} {driver.last_name} نزدیک است: {self.converter.gregorian_to_shamsi(driver.license_expiry_date)}")
            if driver.health_card_expiry_date and driver.health_card_expiry_date < today + timedelta(days=60) and driver.health_card_expiry_date >= today:
                alerts.append(f"تاریخ انقضای کارت سلامت راننده {driver.first_name} {driver.last_name} نزدیک است: {self.converter.gregorian_to_shamsi(driver.health_card_expiry_date)}")

        for vehicle in vehicles:
            if vehicle.insurance_expiry_date and vehicle.insurance_expiry_date < today + timedelta(days=60) and vehicle.insurance_expiry_date >= today:
                alerts.append(f"تاریخ انقضای بیمه وسیله نقلیه {vehicle.plate_number} نزدیک است: {self.converter.gregorian_to_shamsi(vehicle.insurance_expiry_date)}")
            if vehicle.inspection_expiry_date and vehicle.inspection_expiry_date < today + timedelta(days=60) and vehicle.inspection_expiry_date >= today:
                alerts.append(f"تاریخ انقضای معاینه فنی وسیله نقلیه {vehicle.plate_number} نزدیک است: {self.converter.gregorian_to_shamsi(vehicle.inspection_expiry_date)}")

        if alerts:
            self.alerts_label.setText("\n".join(alerts))
        else:
            self.alerts_label.setText("هیچ هشداری وجود ندارد.")

class ReportsWidget(BaseWidget):
    """Widget for generating and exporting various reports."""
    def __init__(self, driver_controller, vehicle_controller, mission_controller):
        super().__init__()
        self.driver_controller = driver_controller
        self.vehicle_controller = vehicle_controller
        self.mission_controller = mission_controller
        self.init_ui()

    def init_ui(self):
        main_layout = QVBoxLayout(self)
        main_layout.addWidget(QLabel("<h2>گزارش‌گیری</h2>", alignment=Qt.AlignmentFlag.AlignCenter))

        filter_frame = QFrame()
        filter_layout = QHBoxLayout(filter_frame)

        filter_layout.addWidget(QLabel("نوع گزارش:"))
        self.report_type_combo = QComboBox()
        self.report_type_combo.addItems([
            "عملکرد رانندگان",
            "وضعیت وسایل نقلیه",
            "ماموریت‌ها بر اساس تاریخ",
            "هزینه‌های ماموریت"
        ])
        filter_layout.addWidget(self.report_type_combo)

        filter_layout.addWidget(QLabel("از تاریخ:"))
        self.start_date_filter = QDateEdit(calendarPopup=True)
        self.start_date_filter.setDate(QDate.currentDate().addMonths(-1)) # QDateEdit works with Gregorian
        filter_layout.addWidget(self.start_date_filter)

        filter_layout.addWidget(QLabel("تا تاریخ:"))
        self.end_date_filter = QDateEdit(calendarPopup=True)
        self.end_date_filter.setDate(QDate.currentDate()) # QDateEdit works with Gregorian
        filter_layout.addWidget(self.end_date_filter)

        self.generate_report_btn = QPushButton("تولید گزارش")
        self.generate_report_btn.clicked.connect(self.generate_report)
        filter_layout.addWidget(self.generate_report_btn)
        main_layout.addWidget(filter_frame)

        self.report_table = QTableWidget()
        self.report_table.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Stretch)
        main_layout.addWidget(self.report_table)

        export_layout = QHBoxLayout()
        self.export_excel_btn = QPushButton("خروجی اکسل")
        self.export_excel_btn.clicked.connect(self.export_to_excel)
        export_layout.addWidget(self.export_excel_btn)

        self.export_pdf_btn = QPushButton("خروجی PDF")
        self.export_pdf_btn.clicked.connect(self.export_to_pdf)
        export_layout.addWidget(self.export_pdf_btn)
        main_layout.addLayout(export_layout)

        main_layout.addWidget(self.back_to_main_button, alignment=Qt.AlignmentFlag.AlignBottom | Qt.AlignmentFlag.AlignLeft)

    def generate_report(self):
        """Generates report data based on selected type and date range."""
        report_type = self.report_type_combo.currentText()
        start_date_greg = self.start_date_filter.date().toPyDate() # Get Gregorian date
        end_date_greg = self.end_date_filter.date().toPyDate() # Get Gregorian date

        data = []
        headers = []

        if report_type == "عملکرد رانندگان":
            drivers = self.driver_controller.get_all_drivers()
            headers = ["نام راننده", "تعداد ماموریت", "کل مصرف سوخت (لیتر)", "مجموع عوارض", "مجموع تعمیرات جزئی"]
            for driver in drivers:
                missions = [m for m in self.mission_controller.get_all_missions() if m.driver_id == driver.id and m.status == "Completed"]
                total_missions = len(missions)
                total_fuel_cost = sum(m.fuel_cost for m in missions if m.fuel_cost is not None)
                total_toll_fees = sum(m.toll_fees for m in missions if m.toll_fees is not None)
                total_minor_repairs = sum(m.minor_repairs_cost for m in missions if m.minor_repairs_cost is not None)
                data.append([f"{driver.first_name} {driver.last_name}", total_missions, total_fuel_cost, total_toll_fees, total_minor_repairs])

        elif report_type == "وضعیت وسایل نقلیه":
            vehicles = self.vehicle_controller.get_all_vehicles()
            headers = ["پلاک", "نوع", "مدل", "وضعیت", "تاریخ آخرین سرویس", "تاریخ انقضای بیمه", "تاریخ انقضای معاینه فنی"]
            for vehicle in vehicles:
                data.append([
                    vehicle.plate_number, vehicle.type, vehicle.model, vehicle.status,
                    self.converter.gregorian_to_shamsi(vehicle.last_service_date) if vehicle.last_service_date else "",
                    self.converter.gregorian_to_shamsi(vehicle.insurance_expiry_date) if vehicle.insurance_expiry_date else "",
                    self.converter.gregorian_to_shamsi(vehicle.inspection_expiry_date) if vehicle.inspection_expiry_date else ""
                ])

        elif report_type == "ماموریت‌ها بر اساس تاریخ":
            missions = self.mission_controller.get_all_missions()
            filtered_missions = []
            for m in missions:
                if m.start_date_time:
                    # Convert stored Gregorian string to QDateTime, then to Gregorian date object for comparison
                    mission_start_date_greg = QDateTime.fromString(m.start_date_time, "yyyy-MM-dd HH:mm:ss").date().toPyDate()
                    if start_date_greg <= mission_start_date_greg <= end_date_greg:
                        filtered_missions.append(m)

            headers = ["ID", "راننده", "وسیله نقلیه", "شروع", "پایان واقعی", "مبدأ", "مقصد", "وضعیت"]
            for mission in filtered_missions:
                data.append([
                    str(mission.id),
                    f"{mission.driver.first_name} {mission.driver.last_name}",
                    mission.vehicle.plate_number,
                    self.converter.qdatetime_to_shamsi_str(self.converter.shamsi_str_to_qdatetime(mission.start_date_time)),
                    self.converter.qdatetime_to_shamsi_str(self.converter.shamsi_str_to_qdatetime(mission.end_date_time_actual)) if mission.end_date_time_actual else "",
                    mission.origin,
                    mission.destination,
                    mission.status
                ])

        elif report_type == "هزینه‌های ماموریت":
            missions = self.mission_controller.get_all_missions()
            filtered_missions = []
            for m in missions:
                if m.status == "Completed" and m.end_date_time_actual:
                    # Convert stored Gregorian string to QDateTime, then to Gregorian date object for comparison
                    mission_end_date_greg = QDateTime.fromString(m.end_date_time_actual, "yyyy-MM-dd HH:mm:ss").date().toPyDate()
                    if start_date_greg <= mission_end_date_greg <= end_date_greg:
                        filtered_missions.append(m)

            headers = ["ID ماموریت", "راننده", "وسیله نقلیه", "تاریخ پایان", "هزینه سوخت", "عوارض", "تعمیرات جزئی", "مجموع هزینه"]
            for mission in filtered_missions:
                total_cost = (mission.fuel_cost or 0) + (mission.toll_fees or 0) + (mission.minor_repairs_cost or 0)
                data.append([
                    str(mission.id),
                    f"{mission.driver.first_name} {mission.driver.last_name}",
                    mission.vehicle.plate_number,
                    self.converter.qdatetime_to_shamsi_str(self.converter.shamsi_str_to_qdatetime(mission.end_date_time_actual)),
                    str(mission.fuel_cost or 0),
                    str(mission.toll_fees or 0),
                    str(mission.minor_repairs_cost or 0),
                    str(total_cost)
                ])

        self.display_report(headers, data)

    def display_report(self, headers, data):
        """Displays the generated report in the table widget."""
        self.report_table.setColumnCount(len(headers))
        self.report_table.setHorizontalHeaderLabels(headers)
        self.report_table.setRowCount(len(data))
        for row, row_data in enumerate(data):
            for col, item in enumerate(row_data):
                self.report_table.setItem(row, col, QTableWidgetItem(str(item)))

    def export_to_excel(self):
        """Exports the current report table data to an Excel file."""
        if self.report_table.rowCount() == 0:
            QMessageBox.warning(self, "خطا", "جدول گزارش خالی است و نمی‌تواند صادر شود.")
            return

        file_name, _ = QFileDialog.getSaveFileName(self, "ذخیره گزارش اکسل", "", "Excel Files (*.xlsx)")
        if file_name:
            if not file_name.endswith(".xlsx"):
                file_name += ".xlsx"

            headers = [self.report_table.horizontalHeaderItem(i).text() for i in range(self.report_table.columnCount())]
            data = []
            for row in range(self.report_table.rowCount()):
                row_data = [self.report_table.item(row, col).text() for col in range(self.report_table.columnCount())]
                data.append(row_data)

            df = pd.DataFrame(data, columns=headers)
            try:
                df.to_excel(file_name, index=False)
                QMessageBox.information(self, "موفقیت", f"گزارش با موفقیت به {file_name} صادر شد.")
            except Exception as e:
                QMessageBox.critical(self, "خطا", f"خطا در صادرات به اکسل: {e}")

    def export_to_pdf(self):
        """Exports the current report table data to a PDF file."""
        if self.report_table.rowCount() == 0:
            QMessageBox.warning(self, "خطا", "جدول گزارش خالی است و نمی‌تواند صادر شود.")
            return

        file_name, _ = QFileDialog.getSaveFileName(self, "ذخیره گزارش PDF", "", "PDF Files (*.pdf)")
        if file_name:
            if not file_name.endswith(".pdf"):
                file_name += ".pdf"

            headers = [self.report_table.horizontalHeaderItem(i).text() for i in range(self.report_table.columnCount())]
            data = []
            for row in range(self.report_table.rowCount()):
                row_data = [self.report_table.item(row, col).text() for col in range(self.report_table.columnCount())]
                data.append(row_data)

            try:
                pdf = FPDF(unit="mm", format="A4")
                pdf.add_page()
                try:
                    pdf.add_font("ArialUnicode", "", FONT_PATH, uni=True)
                    pdf.set_font("ArialUnicode", size=10)
                except Exception as font_err:
                    QMessageBox.warning(self, "خطا در فونت", f"فونت '{FONT_PATH}' پیدا نشد یا مشکل دارد. گزارش ممکن است فارسی را به درستی نمایش ندهد: {font_err}")
                    pdf.set_font("Arial", size=10) # Fallback to default font

                col_width = pdf.w / (len(headers) + 1)
                row_height = 8

                # Headers
                # FPDF's multi_cell doesn't handle RTL well natively without hacks for headers.
                # For simplicity, we'll just use cell for headers.
                # For proper RTL in FPDF, you might need to reverse text or use a specialized library.
                for header in headers:
                    pdf.cell(col_width, row_height, txt=header, border=1, align='C')
                pdf.ln(row_height)

                # Data
                for row_data in data:
                    for item in row_data:
                        # For RTL text in FPDF, you might need to reverse the string or use bidi algorithm.
                        # For simplicity, we'll use it as is.
                        pdf.multi_cell(col_width, row_height, txt=str(item), border=1, align='C', ln=3, max_line_height=pdf.font_size)
                    pdf.ln(row_height)

                pdf.output(file_name)
                QMessageBox.information(self, "موفقیت", f"گزارش با موفقیت به {file_name} صادر شد.")
            except Exception as e:
                QMessageBox.critical(self, "خطا", f"خطا در صادرات به PDF: {e}")


