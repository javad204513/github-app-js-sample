class ShiftController:
    """Manages shift types and driver shift assignments."""
    def __init__(self, session):
        self.session = session

    def add_shift_type(self, name, start_time, end_time):
        """Adds a new shift type."""
        try:
            new_shift = Shift(name=name, start_time=start_time, end_time=end_time)
            self.session.add(new_shift)
            self.session.commit()
            return True, "نوع شیفت با موفقیت اضافه شد."
        except IntegrityError:
            self.session.rollback()
            return False, "نوع شیفت با این نام قبلاً وجود دارد."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در اضافه کردن نوع شیفت: {e}"

    def get_all_shift_types(self):
        """Retrieves all defined shift types."""
        return self.session.query(Shift).all()

    def assign_shift_to_driver(self, driver_id, shift_id, shift_date):
        """Assigns a shift to a driver on a specific date."""
        try:
            existing_shift = self.session.query(DriverShift).filter_by(
                driver_id=driver_id,
                shift_date=shift_date
            ).first()
            if existing_shift:
                return False, "راننده قبلاً در این تاریخ شیفت دارد."

            new_driver_shift = DriverShift(
                driver_id=driver_id,
                shift_id=shift_id,
                shift_date=shift_date
            )
            self.session.add(new_driver_shift)
            self.session.commit()
            return True, "شیفت با موفقیت به راننده اختصاص یافت."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در تخصیص شیفت: {e}"

    def get_driver_shifts(self, driver_id=None, shift_date=None):
        """Retrieves assigned shifts for drivers, optionally filtered by driver ID or date."""
        query = self.session.query(DriverShift).join(Driver).join(Shift)
        if driver_id:
            query = query.filter(DriverShift.driver_id == driver_id)
        if shift_date:
            query = query.filter(DriverShift.shift_date == shift_date)
        return query.all()

    def delete_driver_shift(self, driver_shift_id):
        """Deletes a specific driver shift assignment."""
        try:
            shift = self.session.query(DriverShift).get(driver_shift_id)
            if shift:
                self.session.delete(shift)
                self.session.commit()
                return True, "شیفت تخصیص یافته با موفقیت حذف شد."
            return False, "شیفت یافت نشد."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در حذف شیفت: {e}"

class MissionController:
    """Manages mission data and lifecycle."""
    def __init__(self, session):
        self.session = session

    def add_mission(self, driver_id, vehicle_id, start_date_time, end_date_time_predicted, origin, destination, cargo_description, recipient_sender):
        """Adds a new mission and updates vehicle status."""
        try:
            new_mission = Mission(
                driver_id=driver_id,
                vehicle_id=vehicle_id,
                start_date_time=start_date_time,
                end_date_time_predicted=end_date_time_predicted,
                origin=origin,
                destination=destination,
                cargo_description=cargo_description,
                recipient_sender=recipient_sender,
                status='Pending'
            )
            self.session.add(new_mission)
            vehicle = self.session.query(Vehicle).get(vehicle_id)
            if vehicle:
                vehicle.status = "On Mission"
            self.session.commit()
            return True, "ماموریت با موفقیت ثبت شد."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در ثبت ماموریت: {e}"

    def get_all_missions(self):
        """Retrieves all missions with associated driver and vehicle data."""
        return self.session.query(Mission).join(Driver).join(Vehicle).all()

    def get_mission_by_id(self, mission_id):
        """Retrieves a mission by its ID."""
        return self.session.query(Mission).get(mission_id)

    def update_mission_status(self, mission_id, new_status, actual_end_time=None, fuel_cost=None, toll_fees=None, minor_repairs_cost=None):
        """Updates a mission's status and related completion details."""
        try:
            mission = self.get_mission_by_id(mission_id)
            if mission:
                mission.status = new_status
                if actual_end_time:
                    mission.end_date_time_actual = actual_end_time
                if fuel_cost is not None:
                    mission.fuel_cost = fuel_cost
                if toll_fees is not None:
                    mission.toll_fees = toll_fees
                if minor_repairs_cost is not None:
                    mission.minor_repairs_cost = minor_repairs_cost

                if new_status == 'Completed' or new_status == 'Canceled':
                    vehicle = self.session.query(Vehicle).get(mission.vehicle_id)
                    if vehicle:
                        vehicle.status = "Available"
                self.session.commit()
                return True, "وضعیت ماموریت با موفقیت به‌روز شد."
            return False, "ماموریت یافت نشد."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در به‌روزرسانی وضعیت ماموریت: {e}"

    def delete_mission(self, mission_id):
        """Deletes a mission and reverts vehicle status if necessary."""
        try:
            mission = self.get_mission_by_id(mission_id)
            if mission:
                if mission.status == "On Mission":
                    vehicle = self.session.query(Vehicle).get(mission.vehicle_id)
                    if vehicle:
                        vehicle.status = "Available"
                self.session.delete(mission)
                self.session.commit()
                return True, "ماموریت با موفقیت حذف شد."
            return False, "ماموریت یافت نشد."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در حذف ماموریت: {e}"

# --- ۳. کلاس کمکی تبدیل تاریخ شمسی/میلادی (با استفاده از jdatetime) ---
class ShamsiDateConverter:
    """Helper class for converting between Gregorian and Shamsi (Jalali) dates using jdatetime."""
    def __init__(self):
        pass

    def gregorian_to_shamsi(self, gd: date):
        """Converts a Gregorian date (date object) to a Shamsi string (YYYY/MM/DD)."""
        if not gd: return ""
        try:
            jd = jdatetime.date.fromgregorian(date=gd)
            return jd.strftime("%Y/%m/%d")
        except Exception:
            return "" # Fallback if conversion fails

    def shamsi_to_gregorian(self, sd: str):
        """Converts a Shamsi date string (YYYY/MM/DD) to a Gregorian date object."""
        if not sd: return None
        try:
            year, month, day = map(int, sd.split('/'))
            jd = jdatetime.date(year, month, day)
            return jd.togregorian()
        except ValueError:
            return None
        except Exception:
            return None

    def qdate_to_shamsi(self, qd: QDate):
        """Converts QDate (Gregorian) to Shamsi string."""
        if qd.isNull(): return ""
        return self.gregorian_to_shamsi(qd.toPyDate())

    def shamsi_to_qdate(self, sd: str):
        """Converts Shamsi string to QDate (Gregorian)."""
        g_date = self.shamsi_to_gregorian(sd)
        if g_date:
            return QDate(g_date)
        return QDate() # Return null QDate if conversion fails

    def qdatetime_to_shamsi_str(self, qdt: QDateTime):
        """Converts QDateTime (Gregorian) to Shamsi string (YYYY/MM/DD HH:MM:SS)."""
        if qdt.isNull(): return ""
        g_date = qdt.date().toPyDate()
        time_str = qdt.time().toString("HH:mm:ss")
        shamsi_date_str = self.gregorian_to_shamsi(g_date)
        return f"{shamsi_date_str} {time_str}"

    def shamsi_str_to_qdatetime(self, sdt: str):
        """Converts Shamsi datetime string (YYYY/MM/DD HH:MM:SS) to QDateTime (Gregorian)."""
        if not sdt: return QDateTime()
        try:
            date_part, time_part = sdt.split(' ', 1)
            g_date = self.shamsi_to_gregorian(date_part)
            if g_date:
                dt_obj = datetime.combine(g_date, datetime.strptime(time_part, "%H:%M:%S").time())
                return QDateTime(dt_obj)
            return QDateTime()
        except Exception:
            return QDateTime()

