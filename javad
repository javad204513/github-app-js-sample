class TransportManagementApp(QMainWindow):
    """Main application class integrating all modules."""
    def __init__(self):
        super().__init__()
        self.setWindowTitle("سیستم مدیریت حمل و نقل")
        self.setGeometry(100, 100, 1400, 900) # Larger initial window size

        # Initialize database
        init_db()
        self.session = Session()

        # Initialize controllers
        self.driver_controller = DriverController(self.session)
        self.vehicle_controller = VehicleController(self.session)
        self.shift_controller = ShiftController(self.session)
        self.mission_controller = MissionController(self.session)

        self.central_widget = QWidget()
        self.setCentralWidget(self.central_widget)
        self.main_layout = QVBoxLayout(self.central_widget)

        self.stacked_widget = QStackedWidget()
        self.main_layout.addWidget(self.stacked_widget)

        self._init_ui()

    def _init_ui(self):
        """Initializes and connects all UI widgets."""
        self.main_window_ui = MainWindow()
        self.driver_management_ui = DriverManagementWidget(self.driver_controller)
        self.vehicle_management_ui = VehicleManagementWidget(self.vehicle_controller)
        self.shift_management_ui = ShiftManagementWidget(self.shift_controller, self.driver_controller)
        self.mission_management_ui = MissionManagementWidget(self.mission_controller, self.driver_controller, self.vehicle_controller)
        self.dashboard_ui = DashboardWidget(self.driver_controller, self.vehicle_controller, self.mission_controller)
        self.reports_ui = ReportsWidget(self.driver_controller, self.vehicle_controller, self.mission_controller)

        self.stacked_widget.addWidget(self.main_window_ui) # Index 0: Main/Home
        self.stacked_widget.addWidget(self.driver_management_ui) # Index 1
        self.stacked_widget.addWidget(self.vehicle_management_ui) # Index 2
        self.stacked_widget.addWidget(self.shift_management_ui) # Index 3
        self.stacked_widget.addWidget(self.mission_management_ui) # Index 4
        self.stacked_widget.addWidget(self.dashboard_ui) # Index 5
        self.stacked_widget.addWidget(self.reports_ui) # Index 6

        # Connect navigation signals from main_window_ui
        self.main_window_ui.driver_btn.clicked.connect(lambda: self.set_current_page(1))
        self.main_window_ui.vehicle_btn.clicked.connect(lambda: self.set_current_page(2))
        self.main_window_ui.shift_btn.clicked.connect(lambda: self.set_current_page(3))
        self.main_window_ui.mission_btn.clicked.connect(lambda: self.set_current_page(4))
        self.main_window_ui.dashboard_btn.clicked.connect(lambda: self.set_current_page(5, refresh_dashboard=True))
        self.main_window_ui.reports_btn.clicked.connect(lambda: self.set_current_page(6))

        # Connect "Back to Main" button on each sub-widget
        for i in range(1, self.stacked_widget.count()):
            widget = self.stacked_widget.widget(i)
            # All widgets now inherit BaseWidget and have back_to_main_button
            widget.back_to_main_button.clicked.connect(lambda: self.set_current_page(0))

    def set_current_page(self, index, refresh_dashboard=False):
        """Sets the current page in the stacked widget, with optional refresh."""
        self.stacked_widget.setCurrentIndex(index)
        if refresh_dashboard and index == 5: # Only refresh dashboard when navigating to it
            self.dashboard_ui.refresh_dashboard()

    def closeEvent(self, event):
        """Handles application close event, ensuring database session is closed."""
        self.session.close()
        event.accept()

