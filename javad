        if reply == QMessageBox.StandardButton.Yes:
            vehicle_id = int(self.vehicle_table.item(selected_row, 0).text())
            success, message = self.controller.delete_vehicle(vehicle_id)
            QMessageBox.information(self, "حذف وسیله نقلیه", message)
