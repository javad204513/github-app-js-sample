        }
        success, message = self.controller.update_driver(driver_id, **kwargs)
        QMessageBox.information(self, "به‌روزرسانی راننده", message)
        if success:
            self.load_drivers()
            self.clear_form()

    def delete_driver(self):
        """Deletes the selected driver from the database."""
        selected_row = self.driver_table.currentRow()
        if selected_row < 0:
            QMessageBox.warning(self, "خطا", "لطفاً راننده‌ای را برای حذف انتخاب کنید.")
            return

        reply = QMessageBox.question(self, "حذف راننده", "آیا مطمئن هستید که می‌خواهید این راننده را حذف کنید؟",
