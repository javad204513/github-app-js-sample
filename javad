        for row, mission in enumerate(missions):
            self.mission_table.setItem(row, 0, QTableWidgetItem(str(mission.id)))
            self.mission_table.setItem(row, 1, QTableWidgetItem(f"{mission.driver.first_name} {mission.driver.last_name}"))
            self.mission_table.setItem(row, 2, QTableWidgetItem(mission.vehicle.plate_number))
            # Convert Gregorian datetime string from DB to Shamsi string for display
            self.mission_table.setItem(row, 3, QTableWidgetItem(self.converter.qdatetime_to_shamsi_str(self.converter.shamsi_str_to_qdatetime(mission.start_date_time))))
            self.mission_table.setItem(row, 4, QTableWidgetItem(self.converter.qdatetime_to_shamsi_str(self.converter.shamsi_str_to_qdatetime(mission.end_date_time_predicted)) if mission.end_date_time_predicted else ""))
            self.mission_table.setItem(row, 5, QTableWidgetItem(self.converter.qdatetime_to_shamsi_str(self.converter.shamsi_str_to_qdatetime(mission.end_date_time_actual)) if mission.end_date_time_actual else ""))
            self.mission_table.setItem(row, 6, QTableWidgetItem(mission.origin))
            self.mission_table.setItem(row, 7, QTableWidgetItem(mission.destination))
            self.mission_table.setItem(row, 8, QTableWidgetItem(mission.cargo_description or ""))
            self.mission_table.setItem(row, 9, QTableWidgetItem(mission.recipient_sender or ""))
            self.mission_table.setItem(row, 10, QTableWidgetItem(mission.status))
            self.mission_table.setItem(row, 11, QTableWidgetItem(str(mission.fuel_cost) if mission.fuel_cost is not None else ""))
            self.mission_table.setItem(row, 12, QTableWidgetItem(str(mission.toll_fees) if mission.toll_fees is not None else ""))
            self.mission_table.setItem(row, 13, QTableWidgetItem(str(mission.minor_repairs_cost) if mission.minor_repairs_cost is not None else ""))

    def clear_form(self):
        """Clears all input fields in the form."""
        self.id_input.clear()
        self.driver_combo.setCurrentIndex(0)
        self.vehicle_combo.setCurrentIndex(0)
        self.start_date_time_input.setDateTime(QDateTime.currentDateTime()) # QDateTimeEdit works with Gregorian
        self.end_date_time_predicted_input.setDateTime(QDateTime.currentDateTime().addDays(1)) # QDateTimeEdit works with Gregorian
        self.origin_input.clear()
        self.destination_input.clear()
        self.cargo_description_input.clear()
        self.recipient_sender_input.clear()
        self.status_combo.setCurrentIndex(0)
        self.end_date_time_actual_input.setDateTime(QDateTime.currentDateTime()) # QDateTimeEdit works with Gregorian
        self.fuel_cost_input.clear()
        self.toll_fees_input.clear()
        self.minor_repairs_cost_input.clear()
        self.toggle_completion_fields() # Reset enabled/disabled states

    def add_mission(self):
        """Adds a new mission based on form input."""
        driver_id = self.driver_combo.currentData()
        vehicle_id = self.vehicle_combo.currentData()
        # Get Gregorian datetime string from QDateTimeEdit for DB storage
        start_date_time = self.start_date_time_input.dateTime().toString("yyyy-MM-dd HH:mm:ss")
        end_date_time_predicted = self.end_date_time_predicted_input.dateTime().toString("yyyy-MM-dd HH:mm:ss")
        origin = self.origin_input.text()
        destination = self.destination_input.text()
        cargo_description = self.cargo_description_input.toPlainText()
        recipient_sender = self.recipient_sender_input.text()

        if not (driver_id and vehicle_id and origin and destination):
            QMessageBox.warning(self, "خطا", "لطفاً تمام فیلدهای الزامی (راننده، وسیله نقلیه، مبدأ، مقصد) را پر کنید.")
            return

        success, message = self.controller.add_mission(
            driver_id, vehicle_id, start_date_time, end_date_time_predicted,
            origin, destination, cargo_description, recipient_sender
        )
        QMessageBox.information(self, "ثبت ماموریت", message)
        if success:
            self.load_missions()
            self.clear_form()

    def load_mission_to_form(self):
        """Loads selected mission's data from table to form for editing."""
        selected_row = self.mission_table.currentRow()
        if selected_row >= 0:
            mission_id = int(self.mission_table.item(selected_row, 0).text())
            mission = self.controller.get_mission_by_id(mission_id)
            if mission:
                self.id_input.setText(str(mission.id))
                # Set combo box text by finding the matching data (ID)
                driver_index = self.driver_combo.findData(mission.driver_id)
                if driver_index != -1: self.driver_combo.setCurrentIndex(driver_index)
                vehicle_index = self.vehicle_combo.findData(mission.vehicle_id)
                if vehicle_index != -1: self.vehicle_combo.setCurrentIndex(vehicle_index)

                # Set Gregorian datetime to QDateTimeEdit
                self.start_date_time_input.setDateTime(QDateTime.fromString(mission.start_date_time, "yyyy-MM-dd HH:mm:ss"))
                if mission.end_date_time_predicted:
                    self.end_date_time_predicted_input.setDateTime(QDateTime.fromString(mission.end_date_time_predicted, "yyyy-MM-dd HH:mm:ss"))
                self.origin_input.setText(mission.origin)
                self.destination_input.setText(mission.destination)
                self.cargo_description_input.setText(mission.cargo_description)
                self.recipient_sender_input.setText(mission.recipient_sender)
                self.status_combo.setCurrentText(mission.status)

                if mission.end_date_time_actual:
                    self.end_date_time_actual_input.setDateTime(QDateTime.fromString(mission.end_date_time_actual, "yyyy-MM-dd HH:mm:ss"))
                else:
                    self.end_date_time_actual_input.setDateTime(QDateTime.currentDateTime())

                self.fuel_cost_input.setText(str(mission.fuel_cost) if mission.fuel_cost is not None else "")
                self.toll_fees_input.setText(str(mission.toll_fees) if mission.toll_fees is not None else "")
                self.minor_repairs_cost_input.setText(str(mission.minor_repairs_cost) if mission.minor_repairs_cost is not None else "")

                self.toggle_completion_fields()

    def update_mission(self):
        """Updates an existing mission's status and details."""
        mission_id_text = self.id_input.text()
        if not mission_id_text:
            QMessageBox.warning(self, "خطا", "لطفاً ماموریتی را برای به‌روزرسانی انتخاب کنید.")
            return

        mission_id = int(mission_id_text)
        new_status = self.status_combo.currentText()
        actual_end_time = None
        fuel_cost = None
        toll_fees = None
        minor_repairs_cost = None

        if new_status == "Completed":
            # Get Gregorian datetime string from QDateTimeEdit for DB storage
            actual_end_time = self.end_date_time_actual_input.dateTime().toString("yyyy-MM-dd HH:mm:ss")
            try:
                fuel_cost = float(self.fuel_cost_input.text()) if self.fuel_cost_input.text() else None
                toll_fees = float(self.toll_fees_input.text()) if self.toll_fees_input.text() else None
                minor_repairs_cost = float(self.minor_repairs_cost_input.text()) if self.minor_repairs_cost_input.text() else None
            except ValueError:
                QMessageBox.warning(self, "خطا", "هزینه‌ها باید اعداد معتبر باشند.")
                return

        success, message = self.controller.update_mission_status(
            mission_id, new_status, actual_end_time, fuel_cost, toll_fees, minor_repairs_cost
        )
        QMessageBox.information(self, "به‌روزرسانی ماموریت", message)
        if success:
            self.load_missions()
            self.clear_form()

    def delete_mission(self):
        """Deletes the selected mission."""
        selected_row = self.mission_table.currentRow()
        if selected_row < 0:
            QMessageBox.warning(self, "خطا", "لطفاً ماموریتی را برای حذف انتخاب کنید.")
            return

        reply = QMessageBox.question(self, "حذف ماموریت", "آیا مطمئن هستید که می‌خواهید این ماموریت را حذف کنید؟",
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply == QMessageBox.StandardButton.Yes:
            mission_id = int(self.mission_table.item(selected_row, 0).text())
            success, message = self.controller.delete_mission(mission_id)
            QMessageBox.information(self, "حذف ماموریت", message)
            if success:
                self.load_missions()
                self.clear_form()

