DATABASE_FILE = 'transport_management.db'
Base = declarative_base()
engine = create_engine(f'sqlite:///{DATABASE_FILE}')

class Driver(Base):
    __tablename__ = 'drivers'
    id = Column(Integer, primary_key=True)
    first_name = Column(String, nullable=False)
    last_name = Column(String, nullable=False)
    national_code = Column(String, unique=True, nullable=False)
    phone_number = Column(String)
    address = Column(String)
    hire_date = Column(Date)
    is_active = Column(Boolean, default=True)
    license_expiry_date = Column(Date)
    health_card_expiry_date = Column(Date)

    def __repr__(self):
        return f"<Driver(id={self.id}, name='{self.first_name} {self.last_name}')>"

class Vehicle(Base):
    __tablename__ = 'vehicles'
    id = Column(Integer, primary_key=True)
    type = Column(String, nullable=False) # e.g., کامیون، وانت، سواری
    model = Column(String)
    year = Column(Integer)
    plate_number = Column(String, unique=True, nullable=False)
    vin_number = Column(String)
    status = Column(String, default='Available') # Available, On Mission, In Repair
    insurance_expiry_date = Column(Date)
    inspection_expiry_date = Column(Date)
    fuel_consumption = Column(Float) # Average consumption
    last_service_date = Column(Date)

    def __repr__(self):
        return f"<Vehicle(id={self.id}, plate='{self.plate_number}')>"

class Shift(Base):
    __tablename__ = 'shifts'
    id = Column(Integer, primary_key=True)
    name = Column(String, unique=True, nullable=False) # e.g., شیفت صبح
    start_time = Column(String) # e.g., 08:00
    end_time = Column(String) # e.g., 16:00

class DriverShift(Base):
    __tablename__ = 'driver_shifts'
    id = Column(Integer, primary_key=True)
    driver_id = Column(Integer, ForeignKey('drivers.id'), nullable=False)
    shift_id = Column(Integer, ForeignKey('shifts.id'), nullable=False)
    shift_date = Column(Date, nullable=False)
    driver = relationship('Driver')
    shift = relationship('Shift')

class Mission(Base):
    __tablename__ = 'missions'
    id = Column(Integer, primary_key=True)
    driver_id = Column(Integer, ForeignKey('drivers.id'), nullable=False)
    vehicle_id = Column(Integer, ForeignKey('vehicles.id'), nullable=False)
    start_date_time = Column(String, nullable=False)
    end_date_time_predicted = Column(String)
    end_date_time_actual = Column(String)
    origin = Column(String, nullable=False)
    destination = Column(String, nullable=False)
    cargo_description = Column(Text)
    recipient_sender = Column(String)
    status = Column(String, default='Pending') # Pending, In Progress, Completed, Canceled
    fuel_cost = Column(Float)
    toll_fees = Column(Float)
    minor_repairs_cost = Column(Float)

    driver = relationship('Driver')
    vehicle = relationship('Vehicle')

    def __repr__(self):
        return f"<Mission(id={self.id}, status='{self.status}')>"

def init_db():
    """Initializes the database by creating all defined tables."""
    Base.metadata.create_all(engine)
    print("Database initialized.")

Session = sessionmaker(bind=engine)

