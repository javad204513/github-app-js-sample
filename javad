class DriverController:
    """Manages driver data and database interactions."""
    def __init__(self, session):
        self.session = session

    def add_driver(self, first_name, last_name, national_code, phone_number, address, hire_date, is_active, license_expiry_date, health_card_expiry_date):
        """Adds a new driver to the database."""
        try:
            new_driver = Driver(
                first_name=first_name,
                last_name=last_name,
                national_code=national_code,
                phone_number=phone_number,
                address=address,
                hire_date=hire_date,
                is_active=is_active,
                license_expiry_date=license_expiry_date,
                health_card_expiry_date=health_card_expiry_date
            )
            self.session.add(new_driver)
            self.session.commit()
            return True, "راننده با موفقیت اضافه شد."
        except IntegrityError:
            self.session.rollback()
            return False, "کد ملی تکراری است."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در اضافه کردن راننده: {e}"

    def get_all_drivers(self):
        """Retrieves all drivers from the database."""
        return self.session.query(Driver).all()

    def get_driver_by_id(self, driver_id):
        """Retrieves a driver by their ID."""
        return self.session.query(Driver).get(driver_id)

    def update_driver(self, driver_id, **kwargs):
        """Updates an existing driver's information."""
        try:
            driver = self.get_driver_by_id(driver_id)
            if driver:
                for key, value in kwargs.items():
                    setattr(driver, key, value)
                self.session.commit()
                return True, "اطلاعات راننده با موفقیت به‌روز شد."
            return False, "راننده یافت نشد."
        except IntegrityError:
            self.session.rollback()
            return False, "کد ملی تکراری است."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در به‌روزرسانی راننده: {e}"

    def delete_driver(self, driver_id):
        """Deletes a driver from the database."""
        try:
            driver = self.get_driver_by_id(driver_id)
            if driver:
                self.session.delete(driver)
                self.session.commit()
                return True, "راننده با موفقیت حذف شد."
            return False, "راننده یافت نشد."
        except Exception as e:
            self.session.rollback()
            return False, f"خطا در حذف راننده: {e}"

